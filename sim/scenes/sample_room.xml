<!-- Public stand-in room so anyone can run the sim without a scan.
     Floor, a 75 cm table, a couch and a rug (the play zone). Room frame: meters, z up,
     origin at the rug corner. The arm, camera and collision shapes come from config.yaml. -->
<mujoco model="sample_room">
  <compiler angle="radian"/>
  <option timestep="0.005"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="210" elevation="-30" offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="wood" type="2d" builtin="checker" rgb1="0.42 0.31 0.22" rgb2="0.38 0.28 0.2" width="512" height="512"/>
    <material name="floor" texture="wood" texrepeat="8 8" texuniform="true"/>
    <material name="rug" rgba="0.16 0.16 0.18 1"/>
    <material name="rug_border" rgba="0.62 0.55 0.42 1"/>
    <material name="table" rgba="0.75 0.62 0.45 1"/>
    <material name="couch" rgba="0.12 0.16 0.32 1"/>
    <material name="wall" rgba="0.92 0.92 0.9 1"/>
  </asset>

  <worldbody>
    <light pos="1 1 2.6" dir="0 0 -1" diffuse="0.5 0.5 0.5" castshadow="true"/>
    <geom name="floor" type="plane" size="4 4 0.05" pos="1 1 0" material="floor"/>
    <geom name="rug_border" type="box" size="1.08 0.83 0.002" pos="1.0 0.75 0.002" material="rug_border" contype="0" conaffinity="0"/>
    <geom name="rug" type="box" size="1.0 0.75 0.003" pos="1.0 0.75 0.003" material="rug" contype="0" conaffinity="0"/>
    <!-- Visible furniture (collision copies are added from config.yaml). -->
    <geom name="table_vis" type="box" size="0.3 0.4 0.375" pos="2.4 0.75 0.375" material="table" contype="0" conaffinity="0"/>
    <geom name="couch_seat_vis" type="box" size="1.0 0.45 0.225" pos="1.0 2.5 0.225" material="couch" contype="0" conaffinity="0"/>
    <geom name="couch_back_vis" type="box" size="1.0 0.1 0.425" pos="1.0 2.9 0.425" material="couch" contype="0" conaffinity="0"/>
    <geom name="wall_back" type="box" size="2.5 0.02 1.3" pos="1.0 3.05 1.3" material="wall" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
